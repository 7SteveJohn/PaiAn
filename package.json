{
  "name": "paian",
  "private": true,
  "version": "1.0.0",
  "productName": "拍案",
  "description": "拍案 · 纯本地的网文创作工作台",
  "author": "SevenJohn",
  "engines": {
    "node": ">=18"
  },
  "main": "electron/main.cjs",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "start": "node server.js",
    "electron:dev": "electron .",
    "test": "node tests/run.mjs",
    "test:api": "node tests/api-smoke.mjs",
    "test:ai": "node tests/ai-smoke.mjs",
    "smoke": "npm run build && npm test && npm run test:api && npm run test:ai",
    "smoke:ui": "npm run build && electron . --smoke-test",
    "test:ui": "npm run build && node tests/ui-smoke.mjs",
    "test:ui:gacha": "npm run build && node tests/ui-gacha-smoke.mjs",
    "test:ui:mem": "npm run build && node tests/ui-memory-smoke.mjs",
    "test:ui:ob": "npm run build && node tests/ui-obsidian-smoke.mjs",
    "test:ui:scene": "npm run build && node tests/ui-scene-smoke.mjs",
    "test:tray": "node tests/tray-probe.mjs",
    "check:parity": "node scripts/check-parity.mjs",
    "dist": "npm run build && node scripts/dist.mjs",
    "dist:verify": "npm run dist && node scripts/check-parity.mjs && node scripts/check-dist.mjs"
  },
  "dependencies": {
    "@codemirror/commands": "^6.11.0",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/language": "^6.12.4",
    "@codemirror/search": "^6.7.2",
    "@codemirror/state": "^6.7.4",
    "@codemirror/view": "^6.43.11",
    "@lezer/highlight": "^1.2.3",
    "codemirror": "^6.0.2",
    "diff": "^9.0.0",
    "lucide-react": "^0.469.0",
    "marked": "^18.0.11",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.0",
    "electron": "^44.3.0",
    "electron-builder": "^25.1.8",
    "png2icons": "^2.0.1",
    "sharp": "^0.35.5",
    "typescript": "^5.6.0",
    "vite": "^6.0.0"
  },
  "build": {
    "appId": "com.sevenjohn.writing-workbench",
    "productName": "拍案",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**",
      "electron/**",
      "server.js",
      "server-lib/**",
      "build/icon.ico",
      "!node_modules/**"
    ],
    "asar": true,
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "拍案",
      "artifactName": "拍案-安装包-${version}.exe",
      "deleteAppDataOnUninstall": false
    },
    "portable": {
      "artifactName": "拍案-便携版-${version}.exe"
    }
  }
}
